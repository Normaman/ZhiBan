<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pddcopilot.core.mapper.UserMapper">
  <resultMap id="userAccount" type="com.pddcopilot.core.domain.UserAccount">
    <constructor>
      <idArg column="id" javaType="java.lang.String"/>
      <arg column="username" javaType="java.lang.String"/>
      <arg column="password_hash" javaType="java.lang.String"/>
      <arg column="shop_id" javaType="java.lang.String"/>
      <arg column="role" javaType="java.lang.String"/>
      <arg column="enabled" javaType="_boolean"/>
    </constructor>
  </resultMap>
  <select id="findByUsername" resultMap="userAccount" useCache="false">
    SELECT id,username,password_hash,shop_id,role,enabled FROM app_users WHERE username=#{username}
  </select>

  <insert id="insert">
    INSERT INTO app_users(id,username,password_hash,shop_id,role,enabled,created_at) VALUES
    (#{account.id},#{account.username},#{account.passwordHash},#{account.shopId},#{account.role},#{account.enabled},#{createdAt})
  </insert>

  <select id="authVersion" resultType="java.lang.Long" useCache="false">
    SELECT auth_version FROM app_users WHERE username=#{username}
  </select>

  <update id="revokeAll">
    UPDATE app_users SET auth_version=auth_version+1 WHERE username=#{username}
  </update>

  <update id="changePassword">
    UPDATE app_users SET password_hash=#{hash},auth_version=auth_version+1 WHERE username=#{username} AND
    auth_version=#{version} AND id=#{accountId}
  </update>
</mapper>
