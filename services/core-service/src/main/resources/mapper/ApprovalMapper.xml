<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pddcopilot.core.mapper.ApprovalMapper">
  <select id="findDraftConversation" resultType="org.springframework.util.LinkedCaseInsensitiveMap" useCache="false">
    SELECT m.conversation_id FROM drafts d JOIN messages m ON m.id=d.message_id WHERE d.id=#{draftId}
  </select>

  <select id="lockDraft" resultType="org.springframework.util.LinkedCaseInsensitiveMap" useCache="false">
    SELECT * FROM drafts WHERE id=#{draftId} FOR UPDATE
  </select>

  <select id="findDecision" resultType="org.springframework.util.LinkedCaseInsensitiveMap" useCache="false">
    SELECT * FROM decisions WHERE draft_id=#{draftId} AND revision=#{revision}
  </select>

  <select id="findPendingSends" resultType="org.springframework.util.LinkedCaseInsensitiveMap" useCache="false">
    SELECT id FROM send_command_context WHERE conversation_id=#{conversationId} AND state IN
    ('approved','sending')
  </select>

  <select id="findShop" resultType="org.springframework.util.LinkedCaseInsensitiveMap" useCache="false">
    SELECT * FROM shops WHERE id=#{shopId}
  </select>

  <insert id="insertDecision">
    INSERT INTO decisions(id,draft_id,revision,decision,final_content,reviewer,created_at) VALUES
    (#{approvalId},#{draftId},#{revision},#{decision},#{text},#{actor},#{timestamp})
  </insert>

  <update id="updateDraftState">
    UPDATE drafts SET state=#{state},updated_at=#{timestamp} WHERE id=#{draftId}
  </update>

  <update id="updateMessageState">
    UPDATE messages SET state=#{state} WHERE id=#{messageId}
  </update>

  <insert id="insertSendCommand">
    INSERT INTO send_commands(id,approval_id,draft_id,revision,state,updated_at) VALUES
    (#{command},#{approvalId},#{draftId},#{revision},'approved',#{timestamp})
  </insert>

  <update id="transferConversation">
    UPDATE conversations SET state='transferred',revision=revision+1 WHERE id=#{conversationId}
  </update>

  <update id="saveCards">
    UPDATE decisions SET product_cards=#{cards} WHERE id=#{approval}
  </update>

  <update id="replaceCards">
    UPDATE drafts SET
    product_cards=#{cards},content=#{content},cards_edited=TRUE,revision=revision+1,updated_at=#{time} WHERE
    id=#{draft}
  </update>
</mapper>
