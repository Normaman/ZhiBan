<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pddcopilot.core.mapper.AuthenticationEventMapper">
  <insert id="record">
    INSERT INTO authentication_events VALUES (#{id},#{type},#{value},#{hash},#{hash2},#{now})
  </insert>

  <select id="recent" resultType="org.springframework.util.LinkedCaseInsensitiveMap" useCache="false">
    SELECT event_type,created_at FROM authentication_events WHERE user_id=(SELECT id FROM app_users WHERE
    username=#{username}) ORDER BY created_at DESC LIMIT 30
  </select>
</mapper>
