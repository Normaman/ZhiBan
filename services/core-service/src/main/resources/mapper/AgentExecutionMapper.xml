<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pddcopilot.core.mapper.AgentExecutionMapper">
  <select id="lockRun" resultType="org.springframework.util.LinkedCaseInsensitiveMap" useCache="false">
    SELECT r.*,m.conversation_id,c.shop_id FROM agent_runs r JOIN messages m ON m.id=r.message_id JOIN
    conversations c ON c.id=m.conversation_id WHERE r.id=#{id} FOR UPDATE OF r
  </select>

  <select id="find" resultType="org.springframework.util.LinkedCaseInsensitiveMap" useCache="false">
    SELECT * FROM agent_execution_results WHERE run_id=#{id}
  </select>

  <insert id="insert">
    INSERT INTO agent_execution_results(run_id,request_payload,lease_id,lease_until) VALUES
    (#{id},#{request},#{lease},#{until})
  </insert>

  <update id="lease">
    UPDATE agent_execution_results SET lease_id=#{lease},lease_until=#{until} WHERE run_id=#{id}
  </update>

  <update id="complete">
    UPDATE agent_execution_results SET result=#{result},completed_at=#{now},lease_until=0 WHERE run_id=#{id}
  </update>
</mapper>
