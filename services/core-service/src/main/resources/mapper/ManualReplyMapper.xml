<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pddcopilot.core.mapper.ManualReplyMapper">
  <select id="find" resultType="org.springframework.util.LinkedCaseInsensitiveMap" useCache="false">
    SELECT r.*,s.id AS command_id,s.state FROM manual_replies r JOIN send_commands s ON
    s.manual_reply_id=r.id WHERE r.conversation_id=#{conversation} AND r.request_id=#{request}
  </select>

  <select id="list" resultType="org.springframework.util.LinkedCaseInsensitiveMap" useCache="false">
    SELECT r.id,r.content,r.reviewer,r.created_at,r.conversation_revision,s.id AS
    command_id,s.state,s.error_code FROM manual_replies r JOIN send_commands s ON s.manual_reply_id=r.id
    WHERE r.conversation_id=#{conversation} ORDER BY r.created_at,r.id
  </select>

  <insert id="insertInsertManualReplies">
    INSERT INTO
    manual_replies(id,conversation_id,request_id,conversation_revision,request_revision,content,reviewer,created_at)
    VALUES (#{id},#{conversation},#{request},#{value},#{revision},#{content},#{actor},#{timestamp})
  </insert>

  <update id="insertUpdateConversations">
    UPDATE conversations SET revision=revision+1,updated_at=#{timestamp} WHERE id=#{conversation}
  </update>

  <insert id="enqueue">
    INSERT INTO send_commands(id,manual_reply_id,revision,state,updated_at) VALUES
    (#{command},#{reply},1,'approved',#{timestamp})
  </insert>
</mapper>
